# Copy to .env.local and fill in. Nothing here is secret — the values are
# placeholders — but .env.local is gitignored and yours will be.

# ── Database (required) ─────────────────────────────────────────────
# Provisioned by the Vercel–Neon integration; `vercel env pull` writes the
# whole set. Prisma reads POSTGRES_PRISMA_URL for queries and
# POSTGRES_URL_NON_POOLING for migrations.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ── Auth (required) ─────────────────────────────────────────────────
# Any random 32+ byte string. `openssl rand -base64 32` will do.
AUTH_SECRET=

# ── Google sign-in (optional) ───────────────────────────────────────
# The "Continue with Google" button stays hidden until both are set.
# Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (optional) ────────────────────────────────────────────────
# Without RESEND_API_KEY the mailer logs the message instead of sending it.
# EMAIL_DEV_MODE=true also returns verification and reset links in the API
# response, so those flows are demoable with no provider. Turn it off once
# real email is configured.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DEV_MODE=true

# ── Cron (production only) ──────────────────────────────────────────
# /api/cron/advance-orders refuses every request when this is unset, rather
# than falling open.
CRON_SECRET=

# ── Support assistant ───────────────────────────────────────────────
# The assistant needs exactly one model credential. It fails closed without
# one: the endpoint returns 503 rather than surfacing a provider error.
#
# Production: Vercel AI Gateway. One credential for every provider, spend
# limits in the Vercel dashboard, and switching model is a string change.
# On a Vercel deployment this is automatic via OIDC; locally you need a key.
AI_GATEWAY_API_KEY=

# Testing: a direct Anthropic key, from console.anthropic.com. Takes
# precedence over the gateway when set, so it is easy to switch back — unset
# it and the gateway takes over again. Billed separately from a Claude
# subscription; a Claude Pro or Max plan does not include API credit.
ANTHROPIC_API_KEY=

# Model overrides, one per route.
#   gateway   -> anthropic/claude-sonnet-5   (paid; no date suffixes on these ids)
#   anthropic -> claude-sonnet-5             (paid)
#   openrouter-> nvidia/nemotron-3-super-120b-a12b:free
#
# The OpenRouter default is free and handles the tool loop fine, but free
# endpoints are shared: expect the odd 502 or 429. nemotron-3.5-lightning:free
# is steadier; drop the ":free" suffix, or use anthropic/claude-sonnet-4.5, to
# pay for reliability.
# ASSISTANT_MODEL=anthropic/claude-sonnet-5
# ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-5
# ASSISTANT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# ASSISTANT_EMBED_MODEL=openai/text-embedding-3-small

# Kill switch. Set to false to hide the widget and shut the endpoint, without
# redeploying application code.
# ASSISTANT_ENABLED=false

# Salt for the anonymous rate-limit key, so the table never becomes a list of
# visitor IPs. Falls back to AUTH_SECRET when unset.
# ASSISTANT_CLIENT_SALT=
