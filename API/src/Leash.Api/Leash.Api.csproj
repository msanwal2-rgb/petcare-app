<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bd9e14f6-f72d-4bd9-a818-0a56e3fc0f44</UserSecretsId>
  </PropertyGroup>

  <!--
    The HTTP layer: controllers, the error envelope, the JSON contract, and the
    authentication schemes. No SQL, no business rules — those live in
    Leash.Core, which this project references and which cannot reference back.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leash.Core\Leash.Core.csproj" />
  </ItemGroup>

</Project>
