{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Local development only. This database exists on localhost, on your own
  // machine, with a throwaway password — it is not a secret, so it lives here
  // where you can see it rather than in User Secrets.
  //
  // Production overrides this with an environment variable, which the same
  // GetConnectionString("Default") call reads and which never touches git:
  //   ConnectionStrings__Default=Host=...;Password=<real>
  //
  // Rule: anything that would be damaging if published goes in an environment
  // variable, not in this file.
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=petapp_dev;Username=leash;Password=devonly"
  },

  "Auth": {
    // Signs session cookies and mobile access tokens.
    //
    // This value is a local development key and nothing else. In production it
    // comes from Auth__Secret in the environment: whoever holds it can mint a
    // session for any account, so it is the one secret in this app whose
    // disclosure is indistinguishable from a full compromise.
    //
    // Rotating it signs everybody out, which is a feature — it is the break-glass
    // action if it ever leaks.
    "Secret": "dev-only-do-not-use-anywhere-real-9c5edf47a1b24f0e"

    // Google sign-in is off until both halves are set, and the button on
    // /login appears automatically once they are (REQUIREMENTS.md A6). To turn
    // it on locally: create a Web application client at
    // https://console.cloud.google.com/apis/credentials, add
    // http://localhost:5001/api/v1/auth/google/callback as an authorised
    // redirect URI, then set these two. No code change is needed.
    //
    // "Google": {
    //   "ClientId": "...apps.googleusercontent.com",
    //   "ClientSecret": "..."
    // }
  },

  "App": {
    // Where emailed links point. Configuration, never the Host header — see
    // Infrastructure/AppOrigin.cs for what goes wrong otherwise.
    //
    // The Vite dev server, because a verification link has to open the SPA
    // route that reads the token. In production the SPA and the API are one
    // origin and this is that origin.
    "Origin": "http://localhost:5173",
  },

  // The Vite dev server calls this API directly (web/public/config.js holds
  // the address), so the browser needs it allowed here.
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },

  "Email": {
    // With no provider key the mailer logs instead of sending, so the
    // verification and reset flows are walkable with nothing configured.
    //
    // DevMode additionally returns the action link in the response body, which
    // is what lets /forgot-password be tested without reading a log. It is
    // forced off outside the Development environment whatever this says —
    // see Infrastructure/Email/IMailer.cs.
    "DevMode": true

    // "ResendApiKey": "re_...",
    // "From": "Leash <hello@yourdomain.com>"
  }
}
