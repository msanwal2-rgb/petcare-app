{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Swagger UI at /swagger outside Development. On for the review deployment;
  // set false before real users arrive — it lists every endpoint.
  "Swagger": {
    "Enabled": true
  }

  // When the frontend is a separate site, list its address(es) here (or in
  // appsettings.Production.json on the server) so the browser may call this
  // API from it:
  //
  // "Cors": { "Origins": [ "http://localhost:8081" ] }
}
