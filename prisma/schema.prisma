// Prisma schema for the Pet Care Marketplace ("Leash") backend.
//
// Design notes:
// - Temporal fields (createdAt, dob, availability date, booking start/end) are
//   stored as ISO *strings*, exactly as the frontend produces and consumes
//   them. ISO-8601 sorts lexicographically = chronologically, so ordering and
//   range filters work on strings without any timezone drift.
// - Postgres string arrays back the small enum-ish lists (roles, species, etc.);
//   values are validated with Zod at the API boundary.
// - The response shapes in /types are reconstructed by the serializers in
//   /lib/server/serialize.ts (nested address, vetContact, homeEnvironment,
//   priceRange, distanceMiles).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                String                  @id
  name              String
  email             String                  @unique
  phone             String                  @default("")
  avatarUrl         String
  roles             String[] // "owner" | "caretaker" | "vet"
  addressCity       String
  addressState      String
  lat               Float
  lng               Float
  verified          Boolean                 @default(false)
  createdAt         String
  // Bcrypt hash for email/password login. Null for accounts created purely via
  // an OAuth provider (e.g. Google) that never set a password.
  passwordHash      String?
  // Store operations staff: may advance order fulfillment. Not a marketplace
  // role — it never appears in `roles` or the role toggle.
  //
  // Superseded by `staffRoles` and read only through it; dropped in a later
  // migration once a release has run clean on the new column.
  isOps             Boolean                 @default(false)
  /// Staff privileges, orthogonal to the marketplace `roles` above:
  /// "ops" | "support" | "finance" | "admin". "admin" satisfies every check.
  /// Never appears in the role toggle and is never self-editable.
  staffRoles        String[]
  /// Google's stable subject id, set when an account is linked to Google.
  /// Unique so two accounts can never claim the same Google identity.
  googleId          String?                 @unique
  /// Account lifecycle: "active" | "suspended" | "deleted". Checked in
  /// requireUser(), so a suspension takes effect on the next request rather
  /// than whenever the JWT happens to expire.
  status            String                  @default("active")
  suspendedAt       String?
  suspendedReason   String                  @default("")
  /// Set by a soft delete. The row stays so orders, payments and reviews keep
  /// their author; the personal data on it is scrubbed.
  deletedAt         String?
  lastLoginAt       String?
  /// Sessions issued before this instant are refused. Bumped on password reset,
  /// on suspension, and by an admin forcing a sign-out — this is the only
  /// revocation mechanism available with JWT sessions and no adapter.
  sessionsValidFrom String?
  pets              Pet[]
  caretaker         CaretakerProfile?
  vet               VetProfile?
  orders            Order[]
  notifications     Notification[]
  assistantChats    AssistantConversation[]
  auditEntries      AdminAuditLog[]
  payments          Payment[]
  subscriptions     Subscription[]
  /// Stripe's customer id, so a returning member is not billed as a stranger.
  stripeCustomerId  String?                 @unique

  @@index([status])
  @@map("users")
}

model Pet {
  id                  String           @id
  ownerId             String
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  species             String // "dog" | "cat" | "other"
  breed               String
  sex                 String // "male" | "female"
  dob                 String
  weightLbs           Int
  photoUrl            String
  vaccinated          Boolean
  allergies           String[]
  medications         String[]
  behaviorNotes       String
  feedingInstructions String
  vetName             String
  vetPhone            String
  appointments        VetAppointment[]
  medicalRecords      MedicalRecord[]

  @@index([ownerId])
  @@map("pets")
}

model CaretakerProfile {
  id                    String            @id
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String
  servicesOffered       String[] // ServiceType[]
  serviceRadiusMiles    Int
  acceptedSpecies       String[] // Species[]
  fencedYard            Boolean
  hasOtherPets          Boolean
  smokeFree             Boolean
  certifications        String[]
  backgroundCheckStatus String // "verified" | "pending" | "none"
  rating                Float
  reviewCount           Int
  responseRatePct       Int
  pricing               PricingEntry[]
  availability          AvailabilityDay[]

  @@map("caretaker_profiles")
}

model PricingEntry {
  id          String           @id @default(cuid())
  caretakerId String
  caretaker   CaretakerProfile @relation(fields: [caretakerId], references: [id], onDelete: Cascade)
  serviceType String
  unit        String // "hour" | "day"
  rate        Float

  @@index([caretakerId])
  @@map("pricing_entries")
}

model AvailabilityDay {
  id          String           @id @default(cuid())
  caretakerId String
  caretaker   CaretakerProfile @relation(fields: [caretakerId], references: [id], onDelete: Cascade)
  date        String
  slots       Json // { start: string; end: string }[]

  @@index([caretakerId])
  @@map("availability_days")
}

model Booking {
  id            String    @id
  ownerId       String
  caretakerId   String // CaretakerProfile.id
  petIds        String[]
  serviceType   String
  startDateTime String
  endDateTime   String
  notes         String    @default("")
  status        String    @default("requested")
  priceTotal    Float
  createdAt     String
  messages      Message[]

  @@index([ownerId])
  @@index([caretakerId])
  @@map("bookings")
}

model Review {
  id         String @id
  // The engagement being reviewed: a Booking id, or a VetAppointment id when
  // `kind` is "vet_appointment". Deliberately not a FK — reviews outlive the
  // engagement and the same table serves both sides of the marketplace.
  bookingId  String
  kind       String @default("booking") // "booking" | "vet_appointment"
  fromUserId String
  toUserId   String
  rating     Float
  comment    String
  createdAt  String

  @@index([toUserId])
  @@index([bookingId])
  @@map("reviews")
}

// Booking-scoped chat between the owner and the caretaker (foundation §4).
model Message {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  body       String
  createdAt  String
  readAt     String?

  @@index([bookingId])
  @@map("messages")
}

/**
 * ── Vet care ─────────────────────────────────────────────────────────────
 * Vets are the third side of the marketplace. A VetProfile mirrors
 * CaretakerProfile (user-linked, availability days, rating); appointments
 * mirror bookings (ISO-string times, server-enforced status transitions);
 * medical records are the durable output that the store reads for Rx gating.
 */

model VetProfile {
  id                 String               @id
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicName         String
  bio                String
  specialties        String[] // VetSpecialty[]
  licenseNumber      String
  licenseState       String
  /// Whether a human has checked that licence: "verified" | "pending" | "none".
  /// Mirrors CaretakerProfile.backgroundCheckStatus, which existed but was
  /// display-only — nothing could ever set it, so a "verified" badge meant only
  /// that a fixture said so.
  verificationStatus String               @default("none")
  yearsExperience    Int
  acceptedSpecies    String[] // Species[]
  consultModes       String[] // ConsultMode[]
  consultFee         Float
  emergencyAvailable Boolean              @default(false)
  clinicCity         String
  clinicState        String
  lat                Float
  lng                Float
  rating             Float                @default(0)
  reviewCount        Int                  @default(0)
  responseRatePct    Int                  @default(100)
  availability       VetAvailabilityDay[]
  appointments       VetAppointment[]

  @@map("vet_profiles")
}

model VetAvailabilityDay {
  id    String     @id @default(cuid())
  vetId String
  vet   VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)
  date  String
  slots Json // { start: string; end: string }[]

  @@index([vetId])
  @@map("vet_availability_days")
}

model VetAppointment {
  id            String          @id
  ownerId       String
  vetId         String
  vet           VetProfile      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  petId         String
  pet           Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  mode          String // ConsultMode
  reason        String
  symptoms      String[]
  startDateTime String
  endDateTime   String
  status        String          @default("requested")
  /// What the vet lists, before any membership discount. Snapshotted so a later
  /// profile edit cannot rewrite what somebody was quoted.
  baseFee       Float           @default(0)
  /// The member discount applied at booking time, as a percentage.
  discountPct   Int             @default(0)
  /// Whether this request was made with priority booking. Snapshotted so a
  /// lapsed membership cannot demote a request already in the queue.
  priority      Boolean         @default(false)
  fee           Float
  notes         String          @default("")
  createdAt     String
  records       MedicalRecord[]

  @@index([ownerId])
  @@index([vetId])
  @@index([petId])
  @@map("vet_appointments")
}

model MedicalRecord {
  id             String          @id
  petId          String
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    VetAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vetId          String? // VetProfile.id, when authored by a vet
  authorUserId   String
  type           String // MedicalRecordType
  title          String
  details        String          @default("")
  occurredAt     String
  nextDueAt      String? // next booster / follow-up
  // Prescription-only fields. A record of type "prescription" that is
  // unexpired is what unlocks Rx-only products in the store.
  medicationName String?
  dosage         String?
  refillsLeft    Int?
  expiresAt      String?
  productSlugs   String[] // store products recommended by the vet
  createdAt      String

  @@index([petId])
  @@index([appointmentId])
  @@map("medical_records")
}

/**
 * ── Store ────────────────────────────────────────────────────────────────
 * Money is integer cents everywhere in this domain — floats drift under
 * arithmetic and an order total must not. Order line items snapshot the
 * product's name/brand/price at purchase so history never rewrites itself.
 */

model Product {
  id                   String      @id
  slug                 String      @unique
  name                 String
  brand                String
  description          String
  category             String // ProductCategory
  species              String[] // Species[]
  lifeStage            String[] // LifeStage[]
  sizeLabel            String
  weightLbs            Float
  priceCents           Int
  compareAtPriceCents  Int?
  imageUrl             String
  ingredients          String[]
  allergens            String[] // matched against Pet.allergies
  requiresPrescription Boolean     @default(false)
  stockQty             Int         @default(0)
  active               Boolean     @default(true)
  rating               Float       @default(0)
  reviewCount          Int         @default(0)
  createdAt            String
  orderItems           OrderItem[]

  @@index([category])
  @@index([active])
  @@map("products")
}

model Order {
  id                   String       @id
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String       @default("pending_payment")
  paymentStatus        String       @default("unpaid")
  paymentRef           String?
  subtotalCents        Int
  shippingCents        Int
  taxCents             Int
  totalCents           Int
  shipName             String
  shipLine1            String
  shipLine2            String       @default("")
  shipCity             String
  shipState            String
  shipPostalCode       String
  shipCountry          String       @default("US")
  shipPhone            String       @default("")
  deliveryInstructions String       @default("")
  carrier              String?
  trackingNumber       String?
  placedAt             String
  estimatedDeliveryAt  String?
  deliveredAt          String?
  /// When an unpaid order's stock hold lapses. Null once it is paid.
  reservationExpiresAt String?
  /// Which membership benefits priced this order, snapshotted. History must not
  /// rewrite itself when someone's membership later lapses.
  benefitsApplied      String[]
  items                OrderItem[]
  events               OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Snapshots — deliberately duplicated from Product so a later edit to the
  // catalog can never change what a customer was charged or shipped.
  name           String
  brand          String
  imageUrl       String
  slug           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@map("order_items")
}

// One step in the order's journey from the store to the recipient's home.
// Append-only: the timeline is the audit trail for the tracking page.
model OrderEvent {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String // OrderStatus at the time of the event
  label       String
  description String  @default("")
  location    String?
  occurredAt  String

  @@index([orderId])
  @@map("order_events")
}

/// Something that happened to you while you weren't looking: a vet confirmed
/// your appointment, a caretaker accepted your booking, your order shipped.
///
/// Written by the status machines, never by a client. Read-only to the user
/// apart from marking them read.
model Notification {
  id        String  @id
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // NotificationKind
  title     String
  body      String  @default("")
  /// Where clicking it should take you — the booking, order or appointment.
  href      String
  readAt    String?
  createdAt String

  @@index([userId, createdAt])
  @@map("notifications")
}

// Single-use, expiring tokens for email verification and password reset. Only
// the SHA-256 hash of the token is stored; the raw token lives in the email link.
model VerificationToken {
  id         String @id @default(cuid())
  identifier String // userId (verify_email) or email (reset_password)
  tokenHash  String @unique
  type       String // "verify_email" | "reset_password"
  expiresAt  String
  createdAt  String

  @@index([identifier])
  @@map("verification_tokens")
}

/**
 * ── Support assistant ──────────────────────────────────────────────
 * The in-app support chat. Conversations are kept so a thread survives a
 * reload and so there is a record of what the assistant told a customer.
 */

// A support conversation. Anonymous visitors get one too: `userId` stays null
// and `clientKey` — a salted hash of IP and user agent — is what the rate
// limiter counts against. Deleting a user takes their conversations with them.
model AssistantConversation {
  id        String             @id
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientKey String
  title     String             @default("")
  createdAt String
  updatedAt String
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([clientKey, createdAt])
  @@map("assistant_conversations")
}

// One turn. `parts` holds the full UIMessage parts array — text plus the typed
// tool parts — rather than flat prose, because that is what lets a reloaded
// conversation re-render its tool cards exactly as they first appeared. `text`
// is the flattened copy the rate limiter counts, which saves walking the JSON
// on every check. Token counts are the cost dashboard.
model AssistantMessage {
  id             String                @id
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  parts          Json
  text           String                @default("")
  modelId        String                @default("")
  inputTokens    Int                   @default(0)
  outputTokens   Int                   @default(0)
  createdAt      String

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

// The assistant's retrieval corpus: policy, FAQ, care-guide and vaccine prose,
// chunked and embedded by `npm run kb:ingest`. Reference data, not user data —
// nothing at runtime writes here.
//
// `embedding` is Unsupported because Prisma 6 has no `vector` type, and it is
// written **public.**vector deliberately: Prisma's schema engine sets
// search_path to the target schema alone, so an unqualified `vector` fails with
// `type "vector" does not exist` when the test harness pushes into `test`.
// Qualified, it resolves everywhere.
//
// Nullable is also deliberate: a *required* Unsupported column strips `create`
// and `update` off the generated client for the whole model, which would make
// the ingest script's metadata pass impossible. Prisma omits the column from
// the client either way, so every read and write of the vector is raw SQL.
model KnowledgeChunk {
  id          String                              @id
  sourceKey   String                              @unique
  source      String // "policy" | "faq" | "guide" | "vaccine"
  title       String
  href        String                              @default("")
  species     String[] // "dog" | "cat" | "other"; empty means all
  content     String
  contentHash String
  tokens      Int                                 @default(0)
  embedding   Unsupported("public.vector(1536)")?
  createdAt   String
  updatedAt   String

  @@index([source])
  @@map("knowledge_chunks")
}

/// Every privileged action a staff member takes, append-only.
///
/// Written exclusively by `recordAdminAction()` in lib/server/audit.ts — the
/// same single-seam discipline as `notify()`. An admin console whose actions
/// leave no trace is not an admin console, it is a shared root account.
model AdminAuditLog {
  id          String @id
  actorUserId String
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  /// Dotted verb naming what happened, e.g. "user.suspend", "payment.refund".
  action      String
  /// What it happened to: "user" | "order" | "payment" | "subscription" |
  /// "caretaker_profile" | "vet_profile" | "setting" | "webhook_event".
  targetType  String
  targetId    String @default("")
  /// One human-readable line, written at the call site so the console never has
  /// to reconstruct intent from the metadata blob.
  summary     String
  metadata    Json?
  ip          String @default("")
  createdAt   String

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

/// Runtime configuration an admin can change without a deploy.
///
/// Deliberately small: a setting belongs here only when someone would
/// genuinely need to change it at 2am. Anything that is a deploy-time concern
/// stays an environment variable — `ASSISTANT_ENABLED` in particular is left
/// as an env kill switch rather than mirrored here, because two switches for
/// one behaviour is the redundancy this table exists to avoid.
model SystemSetting {
  key       String @id
  value     Json
  updatedAt String
  updatedBy String @default("")

  @@map("system_settings")
}

/// One recorded attempt against a rate-limited endpoint.
///
/// Counted in Postgres rather than Redis for the same reason the assistant's
/// limiter is: this stack has no Redis, and adding one for a handful of
/// counters would be the wrong trade. Two indexed `count` queries per attempt
/// is cheap.
///
/// The window is a true sliding one. ISO-8601 sorts chronologically — the whole
/// reason this codebase stores timestamps as strings — so `createdAt >= <an
/// hour ago>` is a plain indexed comparison. An hourly bucket would let someone
/// spend two hours' budget in the two minutes either side of the hour.
model RateLimitHit {
  id        String @id
  /// Which limit this counts against, e.g. "signin" | "signup" | "password-reset".
  bucket    String
  /// Who is being counted: a user id, or a salted hash of IP + user agent.
  /// Never a raw IP — this table must not become a log of who visited.
  key       String
  createdAt String

  @@index([bucket, key, createdAt])
  @@map("rate_limit_hits")
}

/// A movement of money, or an attempt at one.
///
/// The order model carried `paymentStatus` and `paymentRef` as two loose
/// columns, which meant there was nowhere to record that money moved but the
/// order didn't — precisely the state a crash between capture and commit used
/// to produce. This is that ledger.
///
/// One row per provider intent or invoice. `orderId` is indexed but NOT unique:
/// a customer whose first intent is cancelled can be issued a fresh one, and
/// the order's live payment is the newest row that has not failed.
model Payment {
  id                  String   @id
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "order" | "subscription_invoice"
  kind                String   @default("order")
  /// Exactly one of these is set. Plain columns rather than a polymorphic FK,
  /// following the precedent of Review.bookingId + Review.kind.
  orderId             String?
  subscriptionId      String?
  /// "stripe" | "demo" | "none" (a zero-value order) | "manual"
  provider            String   @default("stripe")
  /// pi_… / in_… / demo_pi_…. Unique, which is what makes webhook replay safe.
  providerRef         String   @unique
  providerCustomerId  String   @default("")
  /// PaymentStatus — see types/index.ts. Every write goes through the ledger's
  /// applyIntentState, which checks canTransitionPayment first.
  status              String   @default("unpaid")
  amountCents         Int
  amountRefundedCents Int      @default(0)
  currency            String   @default("usd")
  /// Snapshot for the receipt. Never a card number, never a token.
  methodBrand         String   @default("")
  methodLast4         String   @default("")
  failureCode         String   @default("")
  failureMessage      String   @default("")
  /// `event.created` of the newest provider event applied, as ISO. Guards
  /// against a delayed event overwriting a newer one.
  lastEventAt         String   @default("")
  createdAt           String
  updatedAt           String
  succeededAt         String?
  refunds             Refund[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

/// Money going back.
///
/// Written at "pending" *before* the provider is called, so a crash between the
/// two leaves a row a sweep can retry rather than a refund nobody knows was
/// owed. Separate from Payment because a partial refund, a second partial, and
/// who authorised each are all things a finance team asks about.
model Refund {
  id          String  @id
  paymentId   String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// re_… — null until the provider call returns.
  providerRef String? @unique
  amountCents Int
  /// "pending" | "succeeded" | "failed" | "canceled"
  status      String  @default("pending")
  /// "requested_by_customer" | "duplicate" | "fraudulent" | "order_cancelled"
  reason      String  @default("")
  /// The staff member who issued it, or "system" when a cancellation did.
  initiatedBy String  @default("system")
  note        String  @default("")
  createdAt   String
  settledAt   String?

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

/// A subscription product. One row today: Leash Plus.
///
/// Thin on purpose — Stripe is the billing authority, and anything duplicated
/// here is something that can disagree with it. What earns its place is what
/// the app needs without a network call: the price to render on a marketing
/// page, and the `stripePriceId` a webhook resolves back to a plan.
model Plan {
  id                 String         @id
  key                String         @unique
  name               String
  description        String         @default("")
  priceCents         Int
  currency           String         @default("usd")
  /// "month" | "year"
  interval           String         @default("month")
  stripeProductId    String         @default("")
  stripePriceId      String         @default("")
  /// "free_shipping" | "vet_consult_discount" | "priority_booking"
  entitlements       String[]
  consultDiscountPct Int            @default(0)
  active             Boolean        @default(true)
  createdAt          String
  subscriptions      Subscription[]

  @@map("plans")
}

/// Somebody's membership.
///
/// Status mirrors Stripe's own vocabulary rather than inventing a parallel one,
/// because every value here arrives from a webhook and a translation layer is
/// somewhere for the two to drift.
model Subscription {
  id                 String  @id
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan    @relation(fields: [planId], references: [id])
  provider           String  @default("stripe")
  providerRef        String  @unique
  providerCustomerId String  @default("")
  /// "incomplete" | "incomplete_expired" | "trialing" | "active" | "past_due"
  /// | "unpaid" | "canceled"
  status             String  @default("incomplete")
  currentPeriodStart String
  currentPeriodEnd   String
  cancelAtPeriodEnd  Boolean @default(false)
  canceledAt         String?
  endedAt            String?
  /// Set when dunning starts. Benefits survive until this passes — a card
  /// expiring should not strip someone's free shipping mid-order while Stripe
  /// is still retrying.
  graceEndsAt        String?
  latestInvoiceRef   String  @default("")
  lastEventAt        String  @default("")
  createdAt          String
  updatedAt          String

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// One received provider event, kept for idempotency and for replay.
///
/// Keyed on the provider's own event id. The payload is stored so a staff
/// member can re-run an event the automatic retries gave up on — which costs
/// one JSON column and is the difference between "we lost a payment" and "we
/// replayed it".
model WebhookEvent {
  id          String  @id
  provider    String  @default("stripe")
  type        String
  apiVersion  String  @default("")
  /// `event.created` as ISO, for ordering and the staleness guard.
  eventAt     String
  payload     Json
  /// "received" | "processed" | "failed" | "skipped"
  status      String  @default("received")
  attempts    Int     @default(0)
  /// When the current attempt claimed it. A stale lock means a previous attempt
  /// died mid-flight and the event may be retried.
  lockedAt    String?
  error       String  @default("")
  receivedAt  String
  processedAt String?

  @@index([type, eventAt])
  @@index([status, receivedAt])
  @@map("webhook_events")
}
