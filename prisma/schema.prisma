// Prisma schema for the Pet Care Marketplace ("Leash") backend.
//
// Design notes:
// - Temporal fields (createdAt, dob, availability date, booking start/end) are
//   stored as ISO *strings*, exactly as the frontend produces and consumes
//   them. ISO-8601 sorts lexicographically = chronologically, so ordering and
//   range filters work on strings without any timezone drift.
// - Postgres string arrays back the small enum-ish lists (roles, species, etc.);
//   values are validated with Zod at the API boundary.
// - The response shapes in /types are reconstructed by the serializers in
//   /lib/server/serialize.ts (nested address, vetContact, homeEnvironment,
//   priceRange, distanceMiles).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String                  @id
  name           String
  email          String                  @unique
  phone          String                  @default("")
  avatarUrl      String
  roles          String[] // "owner" | "caretaker" | "vet"
  addressCity    String
  addressState   String
  lat            Float
  lng            Float
  verified       Boolean                 @default(false)
  createdAt      String
  // Bcrypt hash for email/password login. Null for accounts created purely via
  // an OAuth provider (e.g. Google) that never set a password.
  passwordHash   String?
  // Store operations staff: may advance order fulfillment. Not a marketplace
  // role — it never appears in `roles` or the role toggle.
  isOps          Boolean                 @default(false)
  pets           Pet[]
  caretaker      CaretakerProfile?
  vet            VetProfile?
  orders         Order[]
  notifications  Notification[]
  assistantChats AssistantConversation[]

  @@map("users")
}

model Pet {
  id                  String           @id
  ownerId             String
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  species             String // "dog" | "cat" | "other"
  breed               String
  sex                 String // "male" | "female"
  dob                 String
  weightLbs           Int
  photoUrl            String
  vaccinated          Boolean
  allergies           String[]
  medications         String[]
  behaviorNotes       String
  feedingInstructions String
  vetName             String
  vetPhone            String
  appointments        VetAppointment[]
  medicalRecords      MedicalRecord[]

  @@index([ownerId])
  @@map("pets")
}

model CaretakerProfile {
  id                    String            @id
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String
  servicesOffered       String[] // ServiceType[]
  serviceRadiusMiles    Int
  acceptedSpecies       String[] // Species[]
  fencedYard            Boolean
  hasOtherPets          Boolean
  smokeFree             Boolean
  certifications        String[]
  backgroundCheckStatus String // "verified" | "pending" | "none"
  rating                Float
  reviewCount           Int
  responseRatePct       Int
  pricing               PricingEntry[]
  availability          AvailabilityDay[]

  @@map("caretaker_profiles")
}

model PricingEntry {
  id          String           @id @default(cuid())
  caretakerId String
  caretaker   CaretakerProfile @relation(fields: [caretakerId], references: [id], onDelete: Cascade)
  serviceType String
  unit        String // "hour" | "day"
  rate        Float

  @@index([caretakerId])
  @@map("pricing_entries")
}

model AvailabilityDay {
  id          String           @id @default(cuid())
  caretakerId String
  caretaker   CaretakerProfile @relation(fields: [caretakerId], references: [id], onDelete: Cascade)
  date        String
  slots       Json // { start: string; end: string }[]

  @@index([caretakerId])
  @@map("availability_days")
}

model Booking {
  id            String    @id
  ownerId       String
  caretakerId   String // CaretakerProfile.id
  petIds        String[]
  serviceType   String
  startDateTime String
  endDateTime   String
  notes         String    @default("")
  status        String    @default("requested")
  priceTotal    Float
  createdAt     String
  messages      Message[]

  @@index([ownerId])
  @@index([caretakerId])
  @@map("bookings")
}

model Review {
  id         String @id
  // The engagement being reviewed: a Booking id, or a VetAppointment id when
  // `kind` is "vet_appointment". Deliberately not a FK — reviews outlive the
  // engagement and the same table serves both sides of the marketplace.
  bookingId  String
  kind       String @default("booking") // "booking" | "vet_appointment"
  fromUserId String
  toUserId   String
  rating     Float
  comment    String
  createdAt  String

  @@index([toUserId])
  @@index([bookingId])
  @@map("reviews")
}

// Booking-scoped chat between the owner and the caretaker (foundation §4).
model Message {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  body       String
  createdAt  String
  readAt     String?

  @@index([bookingId])
  @@map("messages")
}

/**
 * ── Vet care ─────────────────────────────────────────────────────────────
 * Vets are the third side of the marketplace. A VetProfile mirrors
 * CaretakerProfile (user-linked, availability days, rating); appointments
 * mirror bookings (ISO-string times, server-enforced status transitions);
 * medical records are the durable output that the store reads for Rx gating.
 */

model VetProfile {
  id                 String               @id
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicName         String
  bio                String
  specialties        String[] // VetSpecialty[]
  licenseNumber      String
  licenseState       String
  yearsExperience    Int
  acceptedSpecies    String[] // Species[]
  consultModes       String[] // ConsultMode[]
  consultFee         Float
  emergencyAvailable Boolean              @default(false)
  clinicCity         String
  clinicState        String
  lat                Float
  lng                Float
  rating             Float                @default(0)
  reviewCount        Int                  @default(0)
  responseRatePct    Int                  @default(100)
  availability       VetAvailabilityDay[]
  appointments       VetAppointment[]

  @@map("vet_profiles")
}

model VetAvailabilityDay {
  id    String     @id @default(cuid())
  vetId String
  vet   VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)
  date  String
  slots Json // { start: string; end: string }[]

  @@index([vetId])
  @@map("vet_availability_days")
}

model VetAppointment {
  id            String          @id
  ownerId       String
  vetId         String
  vet           VetProfile      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  petId         String
  pet           Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  mode          String // ConsultMode
  reason        String
  symptoms      String[]
  startDateTime String
  endDateTime   String
  status        String          @default("requested")
  fee           Float
  notes         String          @default("")
  createdAt     String
  records       MedicalRecord[]

  @@index([ownerId])
  @@index([vetId])
  @@index([petId])
  @@map("vet_appointments")
}

model MedicalRecord {
  id             String          @id
  petId          String
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    VetAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vetId          String? // VetProfile.id, when authored by a vet
  authorUserId   String
  type           String // MedicalRecordType
  title          String
  details        String          @default("")
  occurredAt     String
  nextDueAt      String? // next booster / follow-up
  // Prescription-only fields. A record of type "prescription" that is
  // unexpired is what unlocks Rx-only products in the store.
  medicationName String?
  dosage         String?
  refillsLeft    Int?
  expiresAt      String?
  productSlugs   String[] // store products recommended by the vet
  createdAt      String

  @@index([petId])
  @@index([appointmentId])
  @@map("medical_records")
}

/**
 * ── Store ────────────────────────────────────────────────────────────────
 * Money is integer cents everywhere in this domain — floats drift under
 * arithmetic and an order total must not. Order line items snapshot the
 * product's name/brand/price at purchase so history never rewrites itself.
 */

model Product {
  id                   String      @id
  slug                 String      @unique
  name                 String
  brand                String
  description          String
  category             String // ProductCategory
  species              String[] // Species[]
  lifeStage            String[] // LifeStage[]
  sizeLabel            String
  weightLbs            Float
  priceCents           Int
  compareAtPriceCents  Int?
  imageUrl             String
  ingredients          String[]
  allergens            String[] // matched against Pet.allergies
  requiresPrescription Boolean     @default(false)
  stockQty             Int         @default(0)
  active               Boolean     @default(true)
  rating               Float       @default(0)
  reviewCount          Int         @default(0)
  createdAt            String
  orderItems           OrderItem[]

  @@index([category])
  @@index([active])
  @@map("products")
}

model Order {
  id                   String       @id
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String       @default("pending_payment")
  paymentStatus        String       @default("unpaid")
  paymentRef           String?
  subtotalCents        Int
  shippingCents        Int
  taxCents             Int
  totalCents           Int
  shipName             String
  shipLine1            String
  shipLine2            String       @default("")
  shipCity             String
  shipState            String
  shipPostalCode       String
  shipCountry          String       @default("US")
  shipPhone            String       @default("")
  deliveryInstructions String       @default("")
  carrier              String?
  trackingNumber       String?
  placedAt             String
  estimatedDeliveryAt  String?
  deliveredAt          String?
  items                OrderItem[]
  events               OrderEvent[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Snapshots — deliberately duplicated from Product so a later edit to the
  // catalog can never change what a customer was charged or shipped.
  name           String
  brand          String
  imageUrl       String
  slug           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@map("order_items")
}

// One step in the order's journey from the store to the recipient's home.
// Append-only: the timeline is the audit trail for the tracking page.
model OrderEvent {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String // OrderStatus at the time of the event
  label       String
  description String  @default("")
  location    String?
  occurredAt  String

  @@index([orderId])
  @@map("order_events")
}

/// Something that happened to you while you weren't looking: a vet confirmed
/// your appointment, a caretaker accepted your booking, your order shipped.
///
/// Written by the status machines, never by a client. Read-only to the user
/// apart from marking them read.
model Notification {
  id        String  @id
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // NotificationKind
  title     String
  body      String  @default("")
  /// Where clicking it should take you — the booking, order or appointment.
  href      String
  readAt    String?
  createdAt String

  @@index([userId, createdAt])
  @@map("notifications")
}

// Single-use, expiring tokens for email verification and password reset. Only
// the SHA-256 hash of the token is stored; the raw token lives in the email link.
model VerificationToken {
  id         String @id @default(cuid())
  identifier String // userId (verify_email) or email (reset_password)
  tokenHash  String @unique
  type       String // "verify_email" | "reset_password"
  expiresAt  String
  createdAt  String

  @@index([identifier])
  @@map("verification_tokens")
}

/**
 * ── Support assistant ──────────────────────────────────────────────
 * The in-app support chat. Conversations are kept so a thread survives a
 * reload and so there is a record of what the assistant told a customer.
 */

// A support conversation. Anonymous visitors get one too: `userId` stays null
// and `clientKey` — a salted hash of IP and user agent — is what the rate
// limiter counts against. Deleting a user takes their conversations with them.
model AssistantConversation {
  id        String             @id
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientKey String
  title     String             @default("")
  createdAt String
  updatedAt String
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([clientKey, createdAt])
  @@map("assistant_conversations")
}

// One turn. `parts` holds the full UIMessage parts array — text plus the typed
// tool parts — rather than flat prose, because that is what lets a reloaded
// conversation re-render its tool cards exactly as they first appeared. `text`
// is the flattened copy the rate limiter counts, which saves walking the JSON
// on every check. Token counts are the cost dashboard.
model AssistantMessage {
  id             String                @id
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  parts          Json
  text           String                @default("")
  modelId        String                @default("")
  inputTokens    Int                   @default(0)
  outputTokens   Int                   @default(0)
  createdAt      String

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

// The assistant's retrieval corpus: policy, FAQ, care-guide and vaccine prose,
// chunked and embedded by `npm run kb:ingest`. Reference data, not user data —
// nothing at runtime writes here.
//
// `embedding` is Unsupported because Prisma 6 has no `vector` type, and it is
// written **public.**vector deliberately: Prisma's schema engine sets
// search_path to the target schema alone, so an unqualified `vector` fails with
// `type "vector" does not exist` when the test harness pushes into `test`.
// Qualified, it resolves everywhere.
//
// Nullable is also deliberate: a *required* Unsupported column strips `create`
// and `update` off the generated client for the whole model, which would make
// the ingest script's metadata pass impossible. Prisma omits the column from
// the client either way, so every read and write of the vector is raw SQL.
model KnowledgeChunk {
  id          String                              @id
  sourceKey   String                              @unique
  source      String // "policy" | "faq" | "guide" | "vaccine"
  title       String
  href        String                              @default("")
  species     String[] // "dog" | "cat" | "other"; empty means all
  content     String
  contentHash String
  tokens      Int                                 @default(0)
  embedding   Unsupported("public.vector(1536)")?
  createdAt   String
  updatedAt   String

  @@index([source])
  @@map("knowledge_chunks")
}
