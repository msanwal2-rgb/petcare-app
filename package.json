{
  "name": "petcare-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "art:generate": "tsx scripts/generate-product-art.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test": "dotenv -e .env.local -- vitest run",
    "e2e": "node scripts/e2e/suite.mjs",
    "e2e:sweep": "node scripts/e2e/sweep.mjs",
    "kb:ingest": "dotenv -e .env.local -- tsx scripts/ingest-knowledge.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.113",
    "@ai-sdk/openai-compatible": "2.0.72",
    "@ai-sdk/react": "3.0.269",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "ai": "6.0.266",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "stripe": "^22.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright-core": "^1.49.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
