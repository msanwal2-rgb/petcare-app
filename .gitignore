# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is placeholders only and is what README's
# `cp .env.local.example .env.local` step expects to find.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Neon integration local artifacts (not needed in repo)
.agents/
.claude/
skills-lock.json

# ── .NET API (API/) ──────────────────────────────────────────────────
API/**/bin/
API/**/obj/
API/**/*.user
API/**/appsettings.*.local.json
# The Vite build is copied here for single-process deployment; it is a
# build artifact, not source.
API/src/Leash.Api/wwwroot/

# ── Vite frontend (web/) ─────────────────────────────────────────────
web/node_modules/
web/dist/
web/*.local

# ── Database working files ───────────────────────────────────────────
# Throwaway databases dumped by db/verify.sh

# Visual Studio / Rider local caches
.vs/
API/.vs/
.idea/
*.suo
