<?xml version="1.0" encoding="utf-8"?>
<!--
  For hosting this frontend as a static IIS site (the API being a separate
  site). Vite copies it into dist/, so every build ships it. Other hosts
  ignore it.

  Built-in IIS features only — no URL Rewrite module needed.
-->
<configuration>
  <system.webServer>
    <!-- React Router owns every path except real files. A path IIS has no
         file for (/dashboard, /pets/p1, …) is answered with index.html, so a
         refresh or a pasted link opens the right screen instead of a 404. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

  <!-- config.js holds the API address and is edited on the server; never let
       a browser keep an old copy. -->
  <location path="config.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
